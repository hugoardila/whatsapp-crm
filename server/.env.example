# Puerto único: API + webhook Twilio + panel CRM (mismo sitio, sin configurar el navegador).
PORT=8989

# Opcional: segundo puerto (p. ej. 8988) sirve el panel y proxifica /api /webhook /socket.io → este PORT.
# Sin proxy el ping /api/* devolvía el HTML del SPA (“No autorizado” / sin JSON).
# Si la API está en otro host: CRM_PANEL_API_TARGET=http://127.0.0.1:3001
# CRM_PORT=8988

NODE_ENV=development

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+573117024021

PUBLIC_WEBHOOK_URL=https://tecnoxpert.com:8989/webhook

# PUBLIC_API_URL=https://tecnoxpert.com:8989

VALIDATE_TWILIO_SIGNATURE=true

# Si abres el panel desde otro dominio/puerto, añádelo aquí (coma separada)
CORS_ORIGINS=https://tecnoxpert.com:8989,http://localhost:5173

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# (Misma clave alimenta el bot WhatsApp y la vista #/cotizaciones → PDF.)
# OPENAI_BOT_ENABLED=true
# OPENAI_MAX_TOKENS=520
# MIN_PHONE_DIGITS=8

# Portal de asesores (#/asesor): JWT para login. Genera un secreto largo aleatorio.
# ADVISOR_JWT_SECRET=cambiar_por_secreto_largo_aleatorio

# Panel CRM principal (ruta /): usuario/contraseña y firma JWT (si no defines CRM_JWT_SECRET, se usa ADVISOR_JWT_SECRET).
# CRM_ADMIN_USER=tecnoxpert
# CRM_ADMIN_PASSWORD=cambiar_en_produccion
# CRM_JWT_SECRET=cambiar_por_secreto_largo_aleatorio

# Logo opcional para PDF de cotizaciones: server/data/brand/logo.png (ver README en esa carpeta).
